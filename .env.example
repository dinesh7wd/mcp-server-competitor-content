LOG_LEVEL=info
RESPECT_ROBOTS_TXT=true
RATE_LIMIT_DELAY_MS=1000
CACHE_TTL_SECONDS=300
ROBOTS_CACHE_TTL_SECONDS=3600
USER_AGENT=mcp-server-competitor-content/1.1 (+https://github.com/dinesh7wd/mcp-server-competitor-content)
HTTP_TIMEOUT_MS=10000
HTTP_RETRIES=2
MAX_BODY_BYTES=2000000
MAX_TEXT_CHARS=100000

# SerpApi only (required for serp_features)
# SERP_PROVIDER=serpapi
# SERP_API_KEY=
# SERP_API_REGION=us

ENABLE_HEADLESS_FALLBACK=true
HEADLESS_MIN_CONTENT_CHARS=200
HEADLESS_TIMEOUT_MS=15000

# After npm install, for headless SPA fallback:
# npx playwright install chromium

# NOTE: This file is documentation only. The server does not load dotenv.
# Set env vars in your MCP client config (Cursor / Claude Desktop / Claude Code).
