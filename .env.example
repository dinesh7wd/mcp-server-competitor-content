LOG_LEVEL=info
RESPECT_ROBOTS_TXT=true
RATE_LIMIT_DELAY_MS=1000
CACHE_TTL_SECONDS=300
ROBOTS_CACHE_TTL_SECONDS=3600
USER_AGENT=mcp-server-competitor-content/1.0 (+https://github.com/your-org/mcp-server-competitor-content)

# SERP (required for serp_features tool)
# SERP_PROVIDER=serpapi
# SERP_API_KEY=
# SERP_API_REGION=us

ENABLE_HEADLESS_FALLBACK=true
HEADLESS_MIN_CONTENT_CHARS=200
HEADLESS_TIMEOUT_MS=15000

# Optional semantic clustering
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
